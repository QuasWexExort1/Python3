   "source": [
    "import re\n",
    "\n",
    "with open(\"text.txt\", \"r\", encoding=\"utf-8\") as f:\n",
    "    words = re.findall(r\"[а-яА-ЯёЁ]+\", f.read())\n",
    "\n",
    "max_len = max(len(w) for w in words)\n",
    "count = sum(1 for w in words if len(w) == max_len)\n",
    "\n",
    "print(count)\n"
   ],
